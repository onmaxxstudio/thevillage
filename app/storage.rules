rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function canAccessRecording(eventId) {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/admin_events/$(eventId)/registrations/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admin_events/$(eventId)).data.published == true &&
        (firestore.get(/databases/(default)/documents/admin_events/$(eventId)).data.access == 'free' ||
          (firestore.exists(/databases/(default)/documents/village_plus_memberships/$(request.auth.uid)) &&
           firestore.get(/databases/(default)/documents/village_plus_memberships/$(request.auth.uid)).data.villagePlus == true &&
           firestore.get(/databases/(default)/documents/village_plus_memberships/$(request.auth.uid)).data.status in ['active', 'trialing'] &&
           firestore.get(/databases/(default)/documents/village_plus_memberships/$(request.auth.uid)).data.currentPeriodEnd > request.time));
    }
    match /monthly_recordings/{eventId}/{fileName} {
      allow read: if isAdmin() || canAccessRecording(eventId);
      allow write: if isAdmin() && request.resource.size < 50 * 1024 * 1024 && request.resource.contentType == 'video/mp4';
    }

    match /profile_photos/{uid}/{fileName} {
      allow read: if signedIn();
      allow delete: if signedIn() && uid == request.auth.uid;
      allow create, update: if false;
    }

    match /admin_content/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && uid == request.auth.uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // My Space attachments are private and addressable only by their owner.
    match /private_journals/{uid}/attachments/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function validUsername(value) {
      return value is string &&
        value.size() >= 3 &&
        value.size() <= 20 &&
        value.matches('^[A-Za-z0-9_]+$');
    }

    function ownsPost(postId) {
      return signedIn() &&
        get(/databases/$(database)/documents/village_post_owners/$(postId))
          .data.uid == request.auth.uid;
    }

    function membersAllowMessages(firstUid, secondUid) {
      return !exists(/databases/$(database)/documents/users/$(firstUid)/blocked/$(secondUid)) &&
        !exists(/databases/$(database)/documents/users/$(secondUid)/blocked/$(firstUid));
    }

    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list, create, update, delete: if false;
    }

    match /admin_communities/{itemId} {
      allow get, list: if signedIn() &&
        (isAdmin() || resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    // Atomic ownership and quota enforcement: one immutable slot per village.
    match /member_community_slots/{slotId} {
      allow get: if signedIn() &&
        slotId.matches('^' + request.auth.uid + '_[0-2]$');
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'slug', 'slot', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.slot is int &&
        request.resource.data.slot >= 0 && request.resource.data.slot < 3 &&
        slotId == request.auth.uid + '_' + string(request.resource.data.slot) &&
        request.resource.data.slug is string &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/member_communities/$(request.resource.data.slug)).data.creatorUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/member_communities/$(request.resource.data.slug)).data.slot == request.resource.data.slot;
      allow update, delete: if false;
    }

    match /member_communities/{slug} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') &&
        slug.size() >= 3 && slug.size() <= 40 &&
        !(slug in ['women', 'moms', 'relationships', 'wellness', 'faith',
          'men', 'friendship', 'career', 'grief', 'new-beginnings',
          'caregivers', 'empty-nest', 'life-after-the-kids',
          'faith-spirituality', 'career-purpose', 'grief-healing']) &&
        request.resource.data.keys().hasOnly([
          'name', 'description', 'purpose', 'creatorUid', 'slot', 'createdAt', 'status'
        ]) &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.resource.data.slot is int &&
        request.resource.data.slot >= 0 && request.resource.data.slot < 3 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 3 &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 15 &&
        request.resource.data.description.size() <= 180 &&
        request.resource.data.purpose is string &&
        request.resource.data.purpose.size() >= 15 &&
        request.resource.data.purpose.size() <= 300 &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/member_community_slots/$(request.auth.uid + '_' + string(request.resource.data.slot))).data.slug == slug;
      allow update, delete: if false;
    }

    match /admin_communities/{itemId} {
      allow get, list: if signedIn() &&
        (isAdmin() || resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    match /admin_resources/{itemId} {
      allow get, list: if signedIn() &&
        (isAdmin() || resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    match /admin_events/{itemId} {
      allow get, list: if signedIn() &&
        (isAdmin() || resource.data.published == true);
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'usernameLower',
          'email',
          'photoUrl',
          'avatarMode',
          'avatarKey',
          'avatarSkin',
          'avatarHair',
          'avatarHairColor',
          'avatarFace',
          'avatarEyes',
          'avatarSmile',
          'avatarPresentation',
          'avatarFacialHair',
          'avatarMole',
          'avatarNose',
          'avatarBrows',
          'avatarGlasses',
          'avatarFreckles',
          'avatarEyeColor',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        validUsername(request.resource.data.username) &&
        request.resource.data.usernameLower ==
          request.resource.data.username.lower() &&
        request.resource.data.email is string &&
        request.resource.data.photoUrl is string &&
        request.resource.data.avatarMode == 'avatar' &&
        request.resource.data.avatarKey in [
          'sage', 'rose', 'gold', 'sky', 'lavender', 'peach',
          'cobalt', 'plum', 'coral', 'mint', 'teal', 'amber'
        ] &&
        request.resource.data.avatarSkin is int && request.resource.data.avatarSkin >= 0 && request.resource.data.avatarSkin <= 11 &&
        request.resource.data.avatarHair is int && request.resource.data.avatarHair >= 0 && request.resource.data.avatarHair <= 10 &&
        request.resource.data.avatarHairColor is int && request.resource.data.avatarHairColor >= 0 && request.resource.data.avatarHairColor <= 9 &&
        request.resource.data.avatarFace is int && request.resource.data.avatarFace >= 0 && request.resource.data.avatarFace <= 2 &&
        request.resource.data.avatarEyes is int && request.resource.data.avatarEyes >= 0 && request.resource.data.avatarEyes <= 2 &&
        request.resource.data.avatarSmile is int && request.resource.data.avatarSmile >= 0 && request.resource.data.avatarSmile <= 2 &&
        request.resource.data.avatarPresentation is int && request.resource.data.avatarPresentation >= 0 && request.resource.data.avatarPresentation <= 2 &&
        request.resource.data.avatarFacialHair is int && request.resource.data.avatarFacialHair >= 0 && request.resource.data.avatarFacialHair <= 4 &&
        request.resource.data.avatarMole is int && request.resource.data.avatarMole >= 0 && request.resource.data.avatarMole <= 4 &&
        request.resource.data.avatarNose is int && request.resource.data.avatarNose >= 0 && request.resource.data.avatarNose <= 2 &&
        request.resource.data.avatarBrows is int && request.resource.data.avatarBrows >= 0 && request.resource.data.avatarBrows <= 2 &&
        request.resource.data.avatarGlasses is int && request.resource.data.avatarGlasses >= 0 && request.resource.data.avatarGlasses <= 2 &&
        request.resource.data.avatarFreckles is int && request.resource.data.avatarFreckles >= 0 && request.resource.data.avatarFreckles <= 2 &&
        request.resource.data.avatarEyeColor is int && request.resource.data.avatarEyeColor >= 0 && request.resource.data.avatarEyeColor <= 5;

      allow delete: if isSelf(uid);
    }

    match /users/{uid}/blocked/{blockedUid} {
      allow get, list, create, update, delete: if isSelf(uid) &&
        (
          request.method == 'get' ||
          request.method == 'list' ||
          request.method == 'delete' ||
          (
            request.resource.data.keys().hasOnly([
              'uid',
              'username',
              'createdAt'
            ]) &&
            request.resource.data.uid == blockedUid &&
            request.resource.data.username is string
          )
        );
    }

    match /public_profiles/{uid} {
      allow get, list: if signedIn();

      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'usernameLower',
          'photoUrl',
          'avatarMode',
          'avatarKey',
          'avatarSkin',
          'avatarHair',
          'avatarHairColor',
          'avatarFace',
          'avatarEyes',
          'avatarSmile',
          'avatarPresentation',
          'avatarFacialHair',
          'avatarMole',
          'avatarNose',
          'avatarBrows',
          'avatarGlasses',
          'avatarFreckles',
          'avatarEyeColor',
          'updatedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        validUsername(request.resource.data.username) &&
        request.resource.data.usernameLower ==
          request.resource.data.username.lower() &&
        request.resource.data.photoUrl is string &&
        request.resource.data.avatarMode == 'avatar' &&
        request.resource.data.avatarKey in [
          'sage', 'rose', 'gold', 'sky', 'lavender', 'peach',
          'cobalt', 'plum', 'coral', 'mint', 'teal', 'amber'
        ] &&
        request.resource.data.avatarSkin is int && request.resource.data.avatarSkin >= 0 && request.resource.data.avatarSkin <= 11 &&
        request.resource.data.avatarHair is int && request.resource.data.avatarHair >= 0 && request.resource.data.avatarHair <= 10 &&
        request.resource.data.avatarHairColor is int && request.resource.data.avatarHairColor >= 0 && request.resource.data.avatarHairColor <= 9 &&
        request.resource.data.avatarFace is int && request.resource.data.avatarFace >= 0 && request.resource.data.avatarFace <= 2 &&
        request.resource.data.avatarEyes is int && request.resource.data.avatarEyes >= 0 && request.resource.data.avatarEyes <= 2 &&
        request.resource.data.avatarSmile is int && request.resource.data.avatarSmile >= 0 && request.resource.data.avatarSmile <= 2 &&
        request.resource.data.avatarPresentation is int && request.resource.data.avatarPresentation >= 0 && request.resource.data.avatarPresentation <= 2 &&
        request.resource.data.avatarFacialHair is int && request.resource.data.avatarFacialHair >= 0 && request.resource.data.avatarFacialHair <= 4 &&
        request.resource.data.avatarMole is int && request.resource.data.avatarMole >= 0 && request.resource.data.avatarMole <= 4 &&
        request.resource.data.avatarNose is int && request.resource.data.avatarNose >= 0 && request.resource.data.avatarNose <= 2 &&
        request.resource.data.avatarBrows is int && request.resource.data.avatarBrows >= 0 && request.resource.data.avatarBrows <= 2 &&
        request.resource.data.avatarGlasses is int && request.resource.data.avatarGlasses >= 0 && request.resource.data.avatarGlasses <= 2 &&
        request.resource.data.avatarFreckles is int && request.resource.data.avatarFreckles >= 0 && request.resource.data.avatarFreckles <= 2 &&
        request.resource.data.avatarEyeColor is int && request.resource.data.avatarEyeColor >= 0 && request.resource.data.avatarEyeColor <= 5;

      allow delete: if isSelf(uid);
    }

    match /usernames/{usernameLower} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        validUsername(request.resource.data.username) &&
        usernameLower == request.resource.data.username.lower();

      allow update: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'createdAt',
          'updatedAt'
        ]) &&
        validUsername(request.resource.data.username) &&
        usernameLower == request.resource.data.username.lower();

      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid;
    }

    function shortAnonymousName(name) {
      return name is string && name.size() <= 13 &&
        name.matches('^[A-Z][a-z]+[A-Z][a-z]+[0-9]{2}$');
    }
    function assignedAnonymousName(uid) {
      let identity = getAfter(/databases/$(database)/documents/anonymous_identities/$(uid)).data;
      return identity.get('displayName', identity.name);
    }
    match /anonymous_identities/{uid} {
      allow get: if isSelf(uid);
      allow list, delete: if false;
      allow create: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['name']) &&
        shortAnonymousName(request.resource.data.name) &&
        !exists(/databases/$(database)/documents/anonymous_names/$(request.resource.data.name)) &&
        getAfter(/databases/$(database)/documents/anonymous_names/$(request.resource.data.name)).data.legacyName == '';
      // One automatic upgrade from the original long name; never user-editable.
      allow update: if isSelf(uid) &&
        resource.data.name.matches('^Neighbor-[a-f0-9]{32}$') &&
        !resource.data.keys().hasAny(['displayName']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']) &&
        shortAnonymousName(request.resource.data.displayName) &&
        !exists(/databases/$(database)/documents/anonymous_names/$(request.resource.data.displayName)) &&
        getAfter(/databases/$(database)/documents/anonymous_names/$(request.resource.data.displayName)).data.legacyName == resource.data.name;
    }
    // Public anonymous aliases only: no UID, real username or profile link.
    match /anonymous_names/{name} {
      allow get, list: if signedIn();
      allow update, delete: if false;
      allow create: if signedIn() && shortAnonymousName(name) &&
        request.resource.data.keys().hasOnly(['legacyName']) &&
        request.resource.data.legacyName is string &&
        assignedAnonymousName(request.auth.uid) == name &&
        (request.resource.data.legacyName == '' && getAfter(/databases/$(database)/documents/anonymous_identities/$(request.auth.uid)).data.name == name ||
         request.resource.data.legacyName.matches('^Neighbor-[a-f0-9]{32}$') && getAfter(/databases/$(database)/documents/anonymous_identities/$(request.auth.uid)).data.name == request.resource.data.legacyName);
    }

    match /village_posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'question',
          'category',
          'audience',
          'author',
          'authorUid',
          'communityId',
          'communityName',
          'createdAt',
          'needsSupport',
          'supportIntent',
          'followUpStatus',
          'resolvedAt',
          'supportCount',
          'replies'
        ]) &&
        request.resource.data.question is string &&
        request.resource.data.question.size() >= 10 &&
        request.resource.data.question.size() <= 1500 &&
        request.resource.data.category is string &&
        (
          !request.resource.data.keys().hasAny(['communityId']) ||
          (
            request.resource.data.communityId is string &&
            request.resource.data.communityId.size() >= 2 &&
            request.resource.data.communityId.size() <= 40
          )
        ) &&
        (
          !request.resource.data.keys().hasAny(['communityName']) ||
          (
            request.resource.data.communityName is string &&
            request.resource.data.communityName.size() >= 2 &&
            request.resource.data.communityName.size() <= 50
          )
        ) &&
        request.resource.data.audience == 'The Village' &&
        request.resource.data.author is string &&
        request.resource.data.author.size() >= 3 &&
        request.resource.data.author.size() <= 41 &&
        (
          (
            request.resource.data.author == assignedAnonymousName(request.auth.uid) &&
            !request.resource.data.keys().hasAny(['authorUid'])
          ) ||
          (
            !request.resource.data.author.matches('^Neighbor-.*') &&
            request.resource.data.author != 'Anonymous Neighbor' &&
            request.resource.data.authorUid == request.auth.uid
          )
        ) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.needsSupport is bool &&
        request.resource.data.supportIntent is string &&
        request.resource.data.supportIntent.size() >= 1 &&
        request.resource.data.supportIntent.size() <= 100 &&
        request.resource.data.followUpStatus == 'Open' &&
        request.resource.data.supportCount == 0 &&
        request.resource.data.replies is list &&
        request.resource.data.replies.size() == 0;

      allow update: if signedIn() &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['supportCount', 'replies']) &&
            request.resource.data.supportCount is int &&
            request.resource.data.supportCount >= 0 &&
            request.resource.data.replies is list &&
            request.resource.data.replies.size() <= 500
          ) ||
          (
            ownsPost(postId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['followUpStatus', 'needsSupport', 'resolvedAt']) &&
            request.resource.data.followUpStatus in [
              'Open',
              'Feeling better',
              'Still need support',
              'Resolved'
            ] &&
            request.resource.data.needsSupport is bool
          ) ||
          (
            ownsPost(postId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['question', 'category', 'supportIntent']) &&
            request.resource.data.question is string &&
            request.resource.data.question.size() >= 10 &&
            request.resource.data.question.size() <= 1500 &&
            request.resource.data.category is string &&
            request.resource.data.supportIntent is string &&
        request.resource.data.supportIntent.size() >= 1 &&
        request.resource.data.supportIntent.size() <= 100
          )
        );

      allow delete: if ownsPost(postId);
    }

    match /village_post_owners/{postId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid;
      allow get, list: if signedIn() &&
        resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid;
    }

    match /circle_requests/{recipientUid}/incoming/{senderUid} {
      allow get, list, delete: if isSelf(recipientUid);

      allow create, update: if signedIn() &&
        request.auth.uid == senderUid &&
        request.resource.data.keys().hasOnly([
          'senderUid',
          'recipientUid',
          'username',
          'photoUrl',
          'createdAt'
        ]) &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.recipientUid == recipientUid &&
        validUsername(request.resource.data.username) &&
        request.resource.data.photoUrl is string;
    }

    match /circles/{ownerUid}/members/{memberUid} {
      allow get, list: if isSelf(ownerUid);

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'usernameLower',
          'photoUrl',
          'status',
          'connectedAt'
        ]) &&
        request.resource.data.uid == memberUid &&
        validUsername(request.resource.data.username) &&
        request.resource.data.usernameLower ==
          request.resource.data.username.lower() &&
        request.resource.data.photoUrl is string &&
        request.resource.data.status is string &&
        (
          request.auth.uid == ownerUid ||
          (
            request.auth.uid == memberUid &&
            exists(/databases/$(database)/documents/circle_requests/$(memberUid)/incoming/$(ownerUid))
          )
        );

      allow update: if signedIn() &&
        request.auth.uid == memberUid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusUpdatedAt']) &&
        request.resource.data.status is string &&
        request.resource.data.status.size() <= 70;

      allow delete: if signedIn() &&
        (request.auth.uid == ownerUid || request.auth.uid == memberUid);
    }

    match /circles/{ownerUid}/settings/{settingId} {
      allow get: if settingId == 'profile' && signedIn() &&
        (isSelf(ownerUid) ||
         exists(/databases/$(database)/documents/circles/$(ownerUid)/members/$(request.auth.uid)));
      allow list: if false;
      allow create, update: if settingId == 'profile' && isSelf(ownerUid) &&
        request.resource.data.keys().hasOnly(['supportStyle', 'availability', 'muteRequests',
          'statusText', 'statusExpiresAt', 'statusUpdatedAt']) &&
        (!request.resource.data.keys().hasAny(['supportStyle']) ||
          request.resource.data.supportStyle in ['Listen first', 'Advice welcome', 'Practical help', 'Give me space']) &&
        (!request.resource.data.keys().hasAny(['availability']) ||
          request.resource.data.availability in ['Here to listen', 'Low energy', 'Away today']) &&
        (!request.resource.data.keys().hasAny(['muteRequests']) ||
          request.resource.data.muteRequests is bool) &&
        (!request.resource.data.keys().hasAny(['statusText']) ||
          (request.resource.data.statusText is string && request.resource.data.statusText.size() <= 280)) &&
        (!request.resource.data.keys().hasAny(['statusExpiresAt']) ||
          request.resource.data.statusExpiresAt == null ||
          request.resource.data.statusExpiresAt is timestamp) &&
        (!request.resource.data.keys().hasAny(['statusUpdatedAt']) ||
          request.method == 'create' && request.resource.data.statusUpdatedAt == request.time ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['statusUpdatedAt']) ||
          request.resource.data.statusUpdatedAt == request.time);
      allow delete: if isSelf(ownerUid);
    }

    match /circles/{ownerUid}/activity/{activityId} {
      allow get, list: if isSelf(ownerUid);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'kind', 'text', 'createdAt', 'groupId']) &&
        request.resource.data.authorUid == request.auth.uid &&
        (isSelf(ownerUid) ||
         exists(/databases/$(database)/documents/circles/$(request.auth.uid)/members/$(ownerUid))) &&
        request.resource.data.kind in ['win', 'moment', 'group', 'support'] &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() <= 40 &&
        request.resource.data.groupId is string &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSelf(ownerUid);
    }

    match /conversations/{conversationId} {
      allow get: if signedIn() &&
        request.auth.uid in resource.data.members;
      allow list: if false;

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['members', 'updatedAt']) &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 2 &&
        request.auth.uid in request.resource.data.members &&
        (
          (
            request.auth.uid == request.resource.data.members[0] &&
            existsAfter(/databases/$(database)/documents/circles/$(request.auth.uid)/members/$(request.resource.data.members[1]))
          ) ||
          (
            request.auth.uid == request.resource.data.members[1] &&
            existsAfter(/databases/$(database)/documents/circles/$(request.auth.uid)/members/$(request.resource.data.members[0]))
          )
        );

      allow update: if signedIn() &&
        request.auth.uid in resource.data.members &&
        request.resource.data.members == resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt']);

      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if signedIn() &&
          request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.members;

        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly([
            'senderUid',
            'recipientUid',
            'text',
            'createdAt',
            'readAt'
          ]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.recipientUid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.members &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000;

        allow update: if signedIn() &&
          request.auth.uid == resource.data.recipientUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt']);

        allow delete: if false;
      }
    }

    // Private one-to-one chats. Every read and write is scoped to the two
    // immutable participants on the parent conversation document.
    match /private_conversations/{conversationId} {
      allow get, list: if signedIn() &&
        request.auth.uid in resource.data.participantUids;

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'participantUids', 'sourceKey', 'sourceType', 'communityId',
          'communityName', 'sourcePostId', 'sourcePostExcerpt',
          'contextExcerpt', 'lastMessage', 'lastSenderUid', 'createdAt',
          'updatedAt', 'unreadFor'
        ]) &&
        request.resource.data.participantUids is list &&
        request.resource.data.participantUids.size() == 2 &&
        request.auth.uid in request.resource.data.participantUids &&
        request.resource.data.participantUids[0] != request.resource.data.participantUids[1] &&
        membersAllowMessages(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        ) &&
        request.resource.data.sourceType in ['village', 'community'] &&
        request.resource.data.sourceKey is string &&
        request.resource.data.communityId is string &&
        request.resource.data.communityName is string &&
        request.resource.data.sourcePostId is string &&
        request.resource.data.sourcePostExcerpt is string &&
        request.resource.data.sourcePostExcerpt.size() <= 1500 &&
        request.resource.data.contextExcerpt is string &&
        request.resource.data.contextExcerpt.size() <= 500 &&
        request.resource.data.lastMessage == '' &&
        request.resource.data.lastSenderUid == request.auth.uid &&
        request.resource.data.unreadFor is list &&
        request.resource.data.unreadFor.size() == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if signedIn() &&
        request.auth.uid in resource.data.participantUids &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt', 'unreadFor']) &&
            membersAllowMessages(
              resource.data.participantUids[0],
              resource.data.participantUids[1]
            ) &&
            request.resource.data.lastMessage is string &&
            request.resource.data.lastMessage.size() <= 2000 &&
            request.resource.data.lastSenderUid == request.auth.uid &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.unreadFor is list &&
            request.resource.data.unreadFor.size() == 1 &&
            request.resource.data.unreadFor[0] in resource.data.participantUids &&
            request.resource.data.unreadFor[0] != request.auth.uid
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['unreadFor']) &&
            request.auth.uid in resource.data.unreadFor &&
            request.resource.data.unreadFor is list &&
            request.resource.data.unreadFor.size() == 0
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        function isConversationMember() {
          return signedIn() &&
            request.auth.uid in get(
              /databases/$(database)/documents/private_conversations/$(conversationId)
            ).data.participantUids;
        }

        allow get, list: if isConversationMember();
        allow create: if isConversationMember() &&
          membersAllowMessages(
            get(/databases/$(database)/documents/private_conversations/$(conversationId)).data.participantUids[0],
            get(/databases/$(database)/documents/private_conversations/$(conversationId)).data.participantUids[1]
          ) &&
          request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt']) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /notifications/{recipientUid}/items/{notificationId} {
      allow get, list, delete: if isSelf(recipientUid);

      allow update: if isSelf(recipientUid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead']) &&
        request.resource.data.isRead is bool;

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'recipientUid',
          'actorUid',
          'type',
          'title',
          'message',
          'destinationIndex',
          'postId',
          'isRead',
          'createdAt'
        ]) &&
        request.resource.data.recipientUid == recipientUid &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 100 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 300 &&
        request.resource.data.destinationIndex is int &&
        request.resource.data.isRead == false &&
        (
          exists(/databases/$(database)/documents/circles/$(recipientUid)/members/$(request.auth.uid)) ||
          (
            request.resource.data.type == 'circle_request' &&
            exists(/databases/$(database)/documents/circle_requests/$(recipientUid)/incoming/$(request.auth.uid))
          ) ||
          (
            request.resource.data.type in ['post_reply', 'post_support'] &&
            request.resource.data.postId is string &&
            get(/databases/$(database)/documents/village_posts/$(request.resource.data.postId))
              .data.authorUid == recipientUid &&
            request.auth.uid != recipientUid
          )
        );
    }

    match /reports/{reportId} {
      allow read, update, delete: if false;

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'reporterUid',
          'reportedUid',
          'targetType',
          'targetId',
          'reason',
          'details',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reportedUid is string &&
        request.resource.data.targetType in [
          'post',
          'reply',
          'profile',
          'message'
        ] &&
        request.resource.data.targetId is string &&
        request.resource.data.targetId.size() > 0 &&
        request.resource.data.reason in [
          'Harassment',
          'Hate or discrimination',
          'Dangerous advice',
          'Spam or scam',
          'Privacy concern',
          'Other'
        ] &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 500 &&
        request.resource.data.status == 'open';
    }

    match /check_ins/{uid}/items/{dayId} {
      allow get, list, delete: if isSelf(uid);

      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly([
          'mood',
          'details',
          'periodStarted',
          'periodEnded',
          'spotting',
          'flowLevel',
          'symptoms',
          'healthNotes',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.mood in [
          'Great',
          'Good',
          'Okay',
          'Low',
          'Struggling',
          'Not good'
        ] &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 500 &&
        request.resource.data.periodStarted is bool &&
        request.resource.data.periodEnded is bool &&
        request.resource.data.spotting is bool &&
        request.resource.data.flowLevel in ['', 'Light', 'Medium', 'Heavy'] &&
        request.resource.data.symptoms is list &&
        request.resource.data.symptoms.size() <= 6 &&
        request.resource.data.healthNotes is string &&
        request.resource.data.healthNotes.size() <= 500 &&
        request.resource.data.createdAt is timestamp;
    }

    match /community_members/{communityId}/members/{uid} {
      allow get, list: if signedIn();
      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['uid', 'joinedAt']) &&
        request.resource.data.uid == uid;
      allow delete: if isSelf(uid);
    }

    // Separate, optional census consent recorded at onboarding.
    match /village_census_consents/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['allowAggregateUse', 'consentVersion', 'updatedAt']) &&
        request.resource.data.allowAggregateUse is bool &&
        request.resource.data.consentVersion == 'census-consent-v1' &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // Daily census: published questions readable by members, management by admins.
    match /village_census_questions/{questionId} {
      allow get, list: if signedIn() &&
        (isAdmin() || resource.data.status == 'published');
      allow create, update, delete: if isAdmin();

      match /votes/{uid} {
        allow get: if isSelf(uid) || isAdmin();
        allow list: if isAdmin();
        allow create: if isSelf(uid) &&
          exists(/databases/$(database)/documents/village_census_questions/$(questionId)) &&
          get(/databases/$(database)/documents/village_census_questions/$(questionId)).data.status == 'published' &&
          request.resource.data.keys().hasOnly(['option', 'createdAt', 'aggregateUseConsent', 'consentVersion']) &&
          request.resource.data.option is string &&
          request.resource.data.option in get(/databases/$(database)/documents/village_census_questions/$(questionId)).data.options &&
          request.resource.data.aggregateUseConsent is bool &&
          (request.resource.data.aggregateUseConsent == false ||
            (request.resource.data.consentVersion == 'census-consent-v1' &&
             exists(/databases/$(database)/documents/village_census_consents/$(uid)) &&
             get(/databases/$(database)/documents/village_census_consents/$(uid)).data.allowAggregateUse == true)) &&
          (request.resource.data.aggregateUseConsent == true ||
            request.resource.data.consentVersion == null) &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Member-only resource feedback; no public access to individual votes.
    match /resource_votes/{resourceId}/members/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid) &&
        resourceId.size() > 0 && resourceId.size() <= 180 &&
        request.resource.data.keys().hasOnly(['uid', 'helpful', 'reason', 'updatedAt']) &&
        request.resource.data.uid == uid &&
        request.resource.data.helpful is bool &&
        request.resource.data.reason in ['', 'Unavailable', 'Ineligible', 'No response', 'Incorrect information'] &&
        (request.resource.data.helpful == false || request.resource.data.reason == '') &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    match /resource_reports/{reportId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['resourceId', 'reporterUid', 'reason', 'status', 'createdAt']) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.resourceId is string &&
        request.resource.data.resourceId.size() > 0 &&
        request.resource.data.resourceId.size() <= 180 &&
        request.resource.data.reason in ['Outdated information', 'Broken link', 'Program closed', 'Incorrect details', 'Other'] &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time;
    }

    function validPrivateJournalFields(data) {
      return data.body is string && data.body.size() <= 30000 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
        (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 500)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 6)) &&
        (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 4)) &&
        (!('entryType' in data) || data.entryType in ['journal', 'guided', 'letter', 'gratitude', 'mood', 'milestone', 'goal']) &&
        (!('mood' in data) || data.mood in ['Happy', 'Calm', 'Grateful', 'Overwhelmed', 'Sad', 'Anxious', 'Motivated', 'Hopeful', 'Tired', 'Angry']) &&
        (!('linkedEntryId' in data) || (data.linkedEntryId is string && data.linkedEntryId.size() <= 160)) &&
        (!('milestoneDate' in data) || data.milestoneDate is timestamp) &&
        (!('milestoneIcon' in data) || (data.milestoneIcon is string && data.milestoneIcon.size() <= 12)) &&
        (!('goalProgress' in data) || (data.goalProgress is int && data.goalProgress >= 0 && data.goalProgress <= 100)) &&
        (!('actionSteps' in data) || (data.actionSteps is list && data.actionSteps.size() <= 30)) &&
        (!('favorite' in data) || data.favorite is bool);
    }

    // My Space entries and autosaved drafts are readable and writable only by their owner.
    // They are never visible to admins, public profiles, or community feeds.
    match /private_journals/{uid}/entries/{entryId} {
      allow get, list, delete: if isSelf(uid);
      allow create: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['body', 'title', 'tags', 'attachments', 'prompt', 'entryType', 'favorite', 'createdAt', 'updatedAt', 'mood', 'linkedEntryId', 'milestoneDate', 'milestoneIcon', 'goalProgress', 'actionSteps']) &&
        validPrivateJournalFields(request.resource.data) &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['body', 'title', 'tags', 'attachments', 'prompt', 'entryType', 'favorite', 'createdAt', 'updatedAt', 'mood', 'linkedEntryId', 'milestoneDate', 'milestoneIcon', 'goalProgress', 'actionSteps']) &&
        validPrivateJournalFields(request.resource.data) &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
    }

    match /private_journals/{uid}/drafts/{draftId} {
      allow get: if isSelf(uid) && draftId == 'write_freely';
      allow list: if isSelf(uid) && draftId == 'write_freely';
      allow create, update: if isSelf(uid) && draftId == 'write_freely' &&
        request.resource.data.keys().hasOnly(['title', 'body', 'tags', 'attachments', 'entryId', 'updatedAt']) &&
        validPrivateJournalFields(request.resource.data) &&
        request.resource.data.title is string &&
        request.resource.data.entryId is string &&
        request.resource.data.entryId.size() <= 160 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid) && draftId == 'write_freely';
    }

    // Prompt bookmarks are private to the member, just like journal entries.
    match /private_journals/{uid}/saved_prompts/{promptId} {
      allow get, list, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['prompt', 'category', 'savedAt']) &&
        request.resource.data.prompt is string &&
        request.resource.data.prompt.size() > 0 &&
        request.resource.data.prompt.size() <= 300 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() <= 60 &&
        request.resource.data.savedAt == request.time;
    }

    // Budget planning data is private to the signed-in owner.
    match /private_journals/{uid}/budget/{budgetId} {
      allow get, list, delete: if isSelf(uid) &&
        (budgetId == 'current' || budgetId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'));
      allow create, update: if isSelf(uid) &&
        (budgetId == 'current' || budgetId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')) &&
        request.resource.data.keys().hasOnly([
          'monthlyIncome', 'savingsGoal', 'savedAmount', 'categories', 'expenses', 'updatedAt'
        ]) &&
        (!('monthlyIncome' in request.resource.data) ||
          (request.resource.data.monthlyIncome is number && request.resource.data.monthlyIncome >= 0 && request.resource.data.monthlyIncome <= 10000000)) &&
        (!('savingsGoal' in request.resource.data) ||
          (request.resource.data.savingsGoal is number && request.resource.data.savingsGoal >= 0 && request.resource.data.savingsGoal <= 10000000)) &&
        (!('savedAmount' in request.resource.data) ||
          (request.resource.data.savedAmount is number && request.resource.data.savedAmount >= 0 && request.resource.data.savedAmount <= 10000000)) &&
        (!('categories' in request.resource.data) ||
          (request.resource.data.categories is list && request.resource.data.categories.size() <= 20)) &&
        (!('expenses' in request.resource.data) ||
          (request.resource.data.expenses is list && request.resource.data.expenses.size() <= 200)) &&
        request.resource.data.updatedAt == request.time;
    }

    // Weekly plans contain private schedules, tasks, meals, and reflections.
    // Only the signed-in owner can read or change their weekly documents.
    match /weekly_plans/{uid}/weeks/{weekId} {
      allow get, list: if isSelf(uid);
      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly([
          'goals', 'tasks', 'groceries', 'meals', 'notes', 'review', 'sharing', 'updatedAt'
        ]) &&
        request.resource.data.goals is list &&
        request.resource.data.goals.size() <= 20 &&
        request.resource.data.tasks is list &&
        request.resource.data.tasks.size() <= 200 &&
        request.resource.data.groceries is list &&
        request.resource.data.groceries.size() <= 300 &&
        request.resource.data.meals is map &&
        request.resource.data.notes is map &&
        request.resource.data.review is string &&
        request.resource.data.review.size() <= 2000 &&
        request.resource.data.sharing is map &&
        request.resource.data.sharing.keys().hasOnly(['tasks', 'meals', 'schedule', 'token']) &&
        request.resource.data.sharing.tasks is bool &&
        request.resource.data.sharing.meals is bool &&
        request.resource.data.sharing.schedule is bool &&
        (!request.resource.data.sharing.keys().hasAny(['token']) ||
          (request.resource.data.sharing.token is string &&
           request.resource.data.sharing.token.matches('^[a-f0-9]{64}$'))) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // A private-link share contains only the sections the owner selected.
    // Guests may fetch one high-entropy token document, but cannot enumerate shares.
    match /weekly_plan_shares/{token} {
      allow get: if token.matches('^[a-f0-9]{64}$') &&
        resource.data.expiresAt is timestamp &&
        resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if signedIn() &&
        token.matches('^[a-f0-9]{64}$') &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'weekLabel', 'payload', 'updatedAt', 'expiresAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.weekLabel is string &&
        request.resource.data.payload is map &&
        request.resource.data.payload.keys().hasOnly(['tasks', 'meals', 'groceries', 'notes']) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time;
      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'weekLabel', 'payload', 'updatedAt', 'expiresAt'
        ]) &&
        request.resource.data.weekLabel is string &&
        request.resource.data.payload is map &&
        request.resource.data.payload.keys().hasOnly(['tasks', 'meals', 'groceries', 'notes']) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
